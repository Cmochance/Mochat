# ========================================
# Mochat 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ========================================

# ---------- 应用配置 ----------
# JWT 密钥（⚠️ 生产环境必须更换为安全随机字符串！）
# 要求：至少 32 字符，包含大小写字母、数字、特殊符号中的三种
# 生成方法: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=<请生成一个安全密钥>

# JWT 算法
ALGORITHM=HS256

# Access Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh Token 过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie 安全策略
# COOKIE_SECURE: 生产环境设为 true（仅通过 HTTPS 传输 Cookie）
# 开发环境（localhost）自动降级为 false，无需手动修改
COOKIE_SECURE=true

# COOKIE_SAMESITE: Cookie SameSite 策略
# strict: 最严格，所有跨站请求都不带 Cookie
# lax: 默认值，允许顶级导航的 GET 请求带 Cookie
# none: 允许所有跨站请求（需配合 COOKIE_SECURE=true）
COOKIE_SAMESITE=lax

# COOKIE_DOMAIN: Cookie 域名，留空则使用当前域名
# 示例: .example.com（注意前导点号，用于子域名共享）
COOKIE_DOMAIN=

# ---------- 数据库配置 ----------
# SQLite 数据库路径（相对于 backend 目录）
DATABASE_URL=sqlite+aiosqlite:///./mochat.db

# PostgreSQL（生产环境推荐）:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mochat

# ---------- 认证模式 ----------
# legacy: 本地 JWT 认证（默认）
# supabase: Supabase Auth
AUTH_PROVIDER=legacy

# ---------- Supabase 配置（AUTH_PROVIDER=supabase 时必填） ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------- AI 模型配置 ----------
# AI 服务 API 密钥（必填）
AI_API_KEY=your-openai-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-3-flash

# AI 最大输出令牌数（根据模型能力调整）
AI_MAX_TOKENS=4096

# AI 温度参数（0-2，越高越随机）
AI_TEMPERATURE=0.7

# ---------- Guard AI 配置 ----------
GUARD_API_KEY=your-openai-api-key-here
GUARD_BASE_URL=https://api.openai.com/v1
GUARD_MODEL=gemini-3-flash

# ---------- CORS 配置 ----------
# 允许的前端域名（逗号分隔，不要使用通配符 *）
# 开发环境示例: http://localhost:3721,http://localhost:3000
# 生产环境示例: https://mochat.example.com
CORS_ORIGINS=http://localhost:3721,http://localhost:3000

# ---------- 调试模式 ----------
# 是否开启调试模式（生产环境必须设为 false）
DEBUG=true

# ---------- 验证码模块配置 ----------
# Resend API 密钥（在 https://resend.com 获取）
RESEND_API_KEY=re_XVy7ayzQ_9RBMs89VkNJJ6Vi8wP4sGFkX

# 发件邮箱（需在 Resend 验证域名）
RESEND_FROM_EMAIL=noreply@auth.mochance.xyz

# 验证码配置
VERIFY_CODE_LENGTH=6
VERIFY_CODE_EXPIRE_MINUTES=5
VERIFY_MAX_ATTEMPTS=5
VERIFY_SEND_COOLDOWN_SECONDS=60
VERIFY_IP_HOURLY_LIMIT=10

# ---------- R2 配置 -----------
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_DOMAIN=https://你的公开访问域名

# ========== AI 绘图服务配置 (picgenerate) ==========
PICGEN_TRANSLATOR_API_KEY=your-translator-api-key
PICGEN_TRANSLATOR_API_BASE=https://your-translator-api-base/v1
PICGEN_TRANSLATOR_MODEL=gpt-4o-mini

PICGEN_IMAGE_API_KEY=your-image-api-key
PICGEN_IMAGE_API_BASE=https://your-image-api-base/v1
PICGEN_IMAGE_MODEL=gemini-3-image

PICGEN_PORT=3903
PICGEN_CORS_ORIGINS=http://localhost:3721,http://localhost:38721

# ---------- 主后端网关转发地址 ----------
# Docker 运行保持默认；本地非 Docker 调试时可改为 http://localhost:30903 / http://localhost:30904
PICGEN_INTERNAL_URL=http://picgenerate:3903
PPTGEN_INTERNAL_URL=http://pptgen:3904

# ---------- PPT 生成服务配置 (pptgen) ----------
PPTGEN_AI_API_KEY=your-ppt-ai-api-key
PPTGEN_AI_API_BASE=https://your-ppt-ai-api-base/v1
PPTGEN_AI_MODEL=gpt-4
PPTGEN_PORT=3904
PPTGEN_CORS_ORIGINS=http://localhost:3721,http://localhost:38721
PPTGEN_CLOUDRUN_URL=https://your-cloudrun-url
PPTGEN_CLOUDRUN_SECRET=your-cloudrun-secret
PPTGEN_CLOUDRUN_TIMEOUT_SECONDS=120
PPTGEN_CLOUDRUN_CONNECT_TIMEOUT_SECONDS=10
PPTGEN_CLOUDRUN_RETRY_TIMES=2
PPTGEN_CLOUDRUN_RETRY_BASE_MS=400
